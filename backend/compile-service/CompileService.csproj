<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RoslynPackageVersion>4.9.2</RoslynPackageVersion>
    <!-- This repository historically tracks build artifacts. Keep them out of
         SDK default Compile globs even when CI redirects obj/bin to /tmp. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynPackageVersion)" />
    <AssemblyMetadata Include="RoslynPackageVersion" Value="$(RoslynPackageVersion)" />
  </ItemGroup>

  <!-- The Python compiler contract and this service consume these exact bytes. -->
  <ItemGroup>
    <Content
      Include="../kukai/compiler_contracts/target_profiles.v1.json"
      Link="compiler_contracts/target_profiles.v1.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The service loads Revit references from NuGet's global-packages folder at
    runtime.  Declare the complete shipped matrix here so `dotnet restore`
    provisions a fresh CI runner / production host without relying on some
    unrelated Bridge build having warmed the cache first.

    PackageDownload is deliberate: it acquires every exact version while
    adding none of these assemblies to CompileService's own net8 compile
    closure.  Keep this list in lockstep with RoslynCompiler.AllShippedVersions;
    startup and /ready remain fail-closed if any DLL is absent.
  -->
  <ItemGroup>
    <PackageDownload
      Include="Revit_All_Main_Versions_API_x64"
      Version="[2021.0.0];[2022.0.0];[2023.0.0];[2024.0.0];[2025.0.0];[2026.0.0]" />
    <PackageDownload
      Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
      Version="[1.0.3]" />
  </ItemGroup>

</Project>
