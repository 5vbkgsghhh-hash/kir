<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- xunit pinned to 2.4.x: Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit 1.1.2
         expects the older EqualException(object, object) ctor that was removed in xunit 2.5+ -->
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
    <!-- Force-pin CodeAnalysis transitive deps to match analyzer project (4.12.0) so the testing
         harness can load our analyzer assembly. Without these, the XUnit testing package
         pulls in CodeAnalysis 1.0.1 and triggers CS1705. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Analyzers\KukaiRevitAnalyzers.csproj" />
  </ItemGroup>

</Project>
