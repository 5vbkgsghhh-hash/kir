<Project>
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <RevitApiVersion>$(RevitVersion).0.0</RevitApiVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Version>0.1.0</Version>
    <Authors>Dima Kuklev</Authors>
    <Company>KIR</Company>
    <Product>KIR Revit Connector</Product>
    <Copyright>Copyright (c) 2026 Dima Kuklev</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2021' Or '$(RevitVersion)' == '2022' Or '$(RevitVersion)' == '2023' Or '$(RevitVersion)' == '2024'">
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion);REVIT_LEGACY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion);REVIT_MODERN</DefineConstants>
  </PropertyGroup>
</Project>
